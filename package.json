{
  "name": "claude-bit",
  "version": "0.1.0",
  "description": "A small Claude Code launcher that puts git worktrees in front of every session.",
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "git",
    "worktree",
    "wrapper"
  ],
  "homepage": "https://github.com/lewis-wow/claude-bit#readme",
  "bugs": {
    "url": "https://github.com/lewis-wow/claude-bit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lewis-wow/claude-bit.git"
  },
  "bin": {
    "claude-bit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "type": "module",
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema": "node scripts/writeSchema.ts && oxfmt schema.json",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
