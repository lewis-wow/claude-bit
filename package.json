{
  "name": "@lewis_wow/claude-bit",
  "version": "0.1.0",
  "private": true,
  "description": "A small Claude Code launcher that puts git worktrees in front of every session. Copy it into a project.",
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "git",
    "worktree",
    "wrapper"
  ],
  "homepage": "https://github.com/lewis-wow/claude-bit#readme",
  "bugs": {
    "url": "https://github.com/lewis-wow/claude-bit/issues"
  },
  "license": "MIT",
  "author": "lewis-wow <ludvik.prokopec@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lewis-wow/claude-bit.git"
  },
  "type": "module",
  "scripts": {
    "dev": "node src/cli.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "ansis": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.25.0"
}
